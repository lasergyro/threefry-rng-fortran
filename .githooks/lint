#!/usr/bin/env bash
# Git pre-commit hook: stop the commit if the staged Fortran or Python has lint
# findings, for you to fix. Fortran: fortitude (settings in fpm.toml) and
# gfortran's warnings (pixi run warn). Python: ruff check. Runs after the
# format hook, so it sees formatted files.
#
# Installed by .githooks/install.sh. Skip once with: git commit --no-verify
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

fortran=() python=()
while IFS= read -r -d '' f; do
  case "$f" in
    *.f90) fortran+=("$f") ;;
    *.py) python+=("$f") ;;
  esac
done < <(git diff --cached --name-only --diff-filter=ACMR -z)

failed=0
if [ ${#fortran[@]} -gt 0 ]; then
  pixi run -q fortitude check --output-format concise "${fortran[@]}" || failed=1
  # gfortran exits 0 on warnings, so any output at all counts as a finding.
  # Compiles every Fortran file, since a change to one module can warn in another.
  out="$(pixi run -q warn 2>&1)" || failed=1
  [ -z "$out" ] || { echo "$out"; failed=1; }
fi
if [ ${#python[@]} -gt 0 ]; then
  pixi run -q ruff check --output-format concise "${python[@]}" || failed=1
fi

if [ "$failed" -ne 0 ]; then
  echo "lint hook: fix the findings above, then commit again (or skip once with --no-verify)" >&2
  exit 1
fi
